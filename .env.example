# Variabili usate dalle API (su Vercel si impostano in Settings -> Environment Variables).
# Questo file contiene solo segnaposto: non inserire qui valori reali.

# Collegamento a Postgres (la imposta da sola l'integrazione Neon di Vercel)
DATABASE_URL=
# Connessioni al database per istanza: 1 su Vercel (default); su un server Node unico, ad esempio 10
DB_POOL_MAX=

# Archivio documenti (deve essere PRIVATO): l'integrazione Vercel Blob imposta da sola BLOB_STORE_ID (accesso OIDC)
# oppure, per archivi più vecchi, BLOB_READ_WRITE_TOKEN
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Primo amministratore, creato solo se non esiste ancora nessun utente
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Opzionale: chiave per firmare le sessioni (se vuota deriva da DATABASE_URL)
SESSION_SECRET=

# ── Portale fornitori ──
# Indirizzo pubblico dell'app, usato nei link degli inviti (se vuoto usa quello della richiesta)
APP_URL=
# Giorni di validità del link d'invito (default 14)
INVITE_DAYS=
# Email (Resend). Senza queste le email vengono solo registrate nel database (tabella notifications)
RESEND_API_KEY=
MAIL_FROM=
# SAP: "simulated" (default, genera un codice fittizio) oppure "http" (invia il JSON a SAP_ENDPOINT)
SAP_MODE=simulated
SAP_ENDPOINT=
SAP_TOKEN=

# ── Scadenze documenti e controllo AI ──
# Chiave del controllo giornaliero dei reminder (Vercel Cron la invia da solo come "Authorization: Bearer ...").
# Genera un valore lungo e casuale; senza questa variabile il controllo automatico non parte.
CRON_SECRET=
# Controllo automatico dei documenti caricati: none (default) | anthropic. Servono anche la chiave e, volendo, il modello.
DOC_AI_PROVIDER=
ANTHROPIC_API_KEY=
DOC_AI_MODEL=

# ── Task e RDA da SAP ──
# Chiave per l'importazione automatica dei file inviati da SAP (POST /api/portal?op=rda-ingest). Senza, i file si caricano a mano dalla pagina Task.
RDA_INGEST_SECRET=

# ── Controlli sui fornitori ──
# VIES (partite IVA UE): live (default) | off | mock (solo test)
VIES_MODE=
# Dati societari (openapi.com): token opzionale
OPENAPI_COMPANY_TOKEN=
OPENAPI_COMPANY_URL=
COMPANY_CHECK_MODE=
# Liste sanzioni: lasciare vuoto per le liste pubbliche; "mock" solo nei test
SANCTIONS_PROVIDER=
OPENSANCTIONS_API_KEY=

# ── Strumenti di prova ──
# Impostare a 1 in produzione reale: disattiva accessi di prova, simulazione del budget e fornitori di prova
DISABLE_DEMO_TOOLS=

# ── Accesso con l'account aziendale (SSO, OpenID Connect) ──
# Spento finché non sono impostati i primi tre. URI di ritorno da registrare presso il provider: <APP_URL>/api/portal?op=sso-callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Facoltativi: domini email ammessi; ruolo dai gruppi del provider come JSON {"<id gruppo>":"buyer"}; creazione utenti al primo accesso (1)
OIDC_ALLOWED_DOMAINS=
OIDC_GROUP_ROLES=
SSO_AUTO_PROVISION=
# 1 = il personale interno entra solo con SSO (fornitori sempre con password); l'account di emergenza resta con password
SSO_ENFORCE=
SSO_BREAKGLASS_EMAIL=
