# Variabili usate dalle API (su Vercel si impostano in Settings -> Environment Variables).
# Questo file contiene solo segnaposto: non inserire qui valori reali.

# Collegamento a Postgres (la imposta da sola l'integrazione Neon di Vercel)
DATABASE_URL=

# Archivio documenti (deve essere PRIVATO): l'integrazione Vercel Blob imposta da sola BLOB_STORE_ID (accesso OIDC)
# oppure, per archivi più vecchi, BLOB_READ_WRITE_TOKEN
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Primo amministratore, creato solo se non esiste ancora nessun utente
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Opzionale: chiave per firmare le sessioni (se vuota deriva da DATABASE_URL)
SESSION_SECRET=

# ── Portale fornitori ──
# Indirizzo pubblico dell'app, usato nei link degli inviti (se vuoto usa quello della richiesta)
APP_URL=
# Giorni di validità del link d'invito (default 14)
INVITE_DAYS=
# Email (Resend). Senza queste le email vengono solo registrate nel database (tabella notifications)
RESEND_API_KEY=
MAIL_FROM=
# SAP: "simulated" (default, genera un codice fittizio) oppure "http" (invia il JSON a SAP_ENDPOINT)
SAP_MODE=simulated
SAP_ENDPOINT=
SAP_TOKEN=
